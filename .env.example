# Copy to .env and adjust. Compose reads .env automatically.

# Image tag used for the locally built images (matches `make build TAG=...`).
TAG=latest

# opencode
OPENCODE_VERSION=1.18.25
OPENCODE_PORT=4096
# Host interface the port is published on. Keep 127.0.0.1 unless you set
# OPENCODE_SERVER_PASSWORD — the server is otherwise unauthenticated.
OPENCODE_BIND=127.0.0.1
OPENCODE_SERVER_PASSWORD=

# Host directory mounted at /work inside the opencode container.
WORKSPACE=./workspace

# Optional provider credentials passed through to the container.
ANTHROPIC_API_KEY=
