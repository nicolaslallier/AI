# Le SDK lance Claude Code, qui lit ces variables.
# Passer par LiteLLM fait apparaître l'usage dans Grafana.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# CA locale de l'Infra pour joindre LiteLLM en HTTPS. Vide : le programme prend
# certs/infra-ca.crt du dépôt. Ne pas mettre SSL_CERT_FILE : il remplacerait toutes
# les autorités de Python et casserait la lecture des issues sur api.github.com.
NODE_EXTRA_CA_CERTS=

# Seulement pour --issue (lecture d'une issue) ; un jeton en lecture seule suffit
GITHUB_TOKEN=
